# Copy this file to `.streamlit/secrets.toml` for local secret-based testing
# (`.env` is simpler locally), or paste the same keys into the Streamlit
# Community Cloud dashboard under: App menu > Settings > Secrets.
# Never commit real keys — `.streamlit/secrets.toml` is gitignored.

GROQ_API_KEY = "your-groq-api-key"
GEMINI_API_KEY = "your-gemini-api-key"
TAVILY_API_KEY = "your-tavily-api-key"

# Optional overrides
# PLANNER_MODEL = "openai/gpt-oss-120b"
# ANALYSIS_MODEL = "openai/gpt-oss-120b"
# CRITIC_MODEL = "gemini-3.8-flash"
# SYNTHESIS_MODEL = "gemini-3.8-flash"
# MAX_QUERY_LEN = "4000"
# MIN_QUERY_LEN = "3"
